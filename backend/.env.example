# Copy to .env; loaded as Java properties when starting from backend.
# Use KEY=value without quotes or export.
YOUTUBE_API_KEY=
DB_URL=jdbc:mysql://localhost:3306/reon
DB_USERNAME=reon
DB_PASSWORD=

# Google ID token audience: the web client ID used by the mobile app
GOOGLE_CLIENT_ID=

# YouTube OAuth: same web client as the login client, registered callback URI
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
# Base64-encoded 32-byte key; keep stable to read stored tokens
YOUTUBE_TOKEN_ENCRYPTION_KEY=

MEMORY_ENGINE_URL=http://127.0.0.1:18081
REON_ENGINE_TOKEN=
