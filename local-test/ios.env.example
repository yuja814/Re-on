# Copy to .env.ios.local at the project root. Do not add backend secrets here.
# Choose a unique bundle identifier, then use the SAME value in Google Cloud's iOS client.
REON_IOS_BUNDLE_IDENTIFIER=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Same web client ID used by the backend to verify ID tokens.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# The Mac's Wi-Fi IP address, never localhost on a physical iPhone.
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:18090
EXPO_PUBLIC_CAPTURE_LOCATION=false
